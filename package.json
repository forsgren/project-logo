{
    "name": "project-logo",
    "displayName": "Project Logo",
    "icon": "images/icon.png",
    "description": "Displays a image or logo from the .vscode folder in the sidebar. This is useful for quickly identifying separate projects in different windows from each other.",
    "version": "1.2.0",
    "publisher": "forsgren",
    "repository": {
        "type": "git",
        "url": "https://github.com/forsgren/project-logo"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "projectLogo",
                    "name": "Project Logo"
                }
            ]
        },
        "commands": []
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "20.x",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.11.0",
        "typescript": "^5.4.5",
        "typescript-eslint": "^8.70.1"
    },
    "overrides": {
        "mocha": "^12.0.2"
    }
}
